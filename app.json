{
  "expo": {
    "name": "NovaPulse",
    "slug": "novapulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "novapulse",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "android": {
      "package": "com.vectors.elementtech.novapulse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.vectors.elementtech.novapulse"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d57c661-115b-4302-927d-6265c5ad8fbc"
      }
    },
    "jsEngine": "jsc",
    "icon": "./assets/icon.png"
  }
}
